{
  "objective": "Call counter.step until its result value reaches 3, then finish.",
  "data_dir": "runs/meta-agent",
  "max_decision_steps": 16,
  "backends": {
    "llm": {
      "kind": "chat_completions",
      "endpoint": "http://127.0.0.1:8000/v1"
    }
  },
  "roles": {
    "decision_maker": {
      "backend_id": "llm",
      "model_id": "your-served-model",
      "revision": "your-model-revision"
    }
  },
  "framework": {
    "controller": {
      "name": "meta_agent",
      "config": {
        "memory": true,
        "harness": "default"
      }
    },
    "labs": {
      "counter": {
        "name": "counter",
        "config": {
          "initial": 0
        }
      }
    }
  }
}
