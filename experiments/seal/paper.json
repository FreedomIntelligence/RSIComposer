{
  "objective": "SEAL paper protocol: disjoint 50-document rounds, 5 candidates, 3 inner seeds, semantic rewards",
  "data_dir": "../../runs/seal-paper",
  "max_decision_steps": 12,
  "framework": {
    "controller": {
      "name": "seal",
      "config": {
        "initial_model": "models/Qwen2.5-7B-d1497293",
        "train_data": [
          "runs/seal-paper-data/train-round-1.json",
          "runs/seal-paper-data/train-round-2.json"
        ],
        "eval_data": "runs/seal-paper-data/heldout.json",
        "iterations": 2,
        "candidates": 5
      }
    },
    "labs": {
      "seal": {
        "name": "seal",
        "config": {
          "profile": "paper",
          "gpu_ids": [
            0,
            1,
            2,
            3,
            4,
            5,
            6,
            7
          ],
          "outer_gpu_ids": [
            0,
            1
          ],
          "outer_gradient_accumulation_steps": 5,
          "seed": 73,
          "training_python": ".local/envs/paper2025/bin/python",
          "inference_python": ".local/envs/paper2025/bin/python",
          "worker_timeout": 86400
        }
      }
    }
  }
}
