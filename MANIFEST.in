include README.md README_zh.md LICENSE NOTICE CITATION.cff
recursive-include configs *.json
recursive-include examples *.py *.json *.jsonl
recursive-include experiments *.py *.sh *.json *.txt
recursive-include docs/diagrams *.svg *.py
recursive-include src/rsimonitor *.py *.toml *.html *.css *.js LICENSE NOTICE
recursive-include tests *.py *.js
recursive-include tools *.py
recursive-include requirements *.txt
prune .local
prune .github
global-exclude __pycache__ *.py[cod] .DS_Store
