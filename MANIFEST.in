include README.md README_zh.md LICENSE
include src/rsicomposer/README.md src/rsimonitor/README.md
recursive-include src/rsicomposer/labs/scenes README.md
recursive-include src/rsicomposer/labs/_template *.json *.jsonl README.md
include assets/rsisys-overview.png
include src/rsicomposer/runtime/orchestration/monitor_contract.json
recursive-include src/rsicomposer/algorithms *.json *.jsonl *.toml *.txt README.md
recursive-include src/rsimonitor *.py *.toml *.html *.css *.js *.json LICENSE
recursive-include requirements *.txt
prune recipes
prune examples
prune tests
prune tools
prune .local
global-exclude __pycache__ *.py[cod] .DS_Store

recursive-include src/rsimonitor/frontend *.vue *.js *.mjs *.json *.json5 *.css
prune src/rsimonitor/frontend/node_modules
