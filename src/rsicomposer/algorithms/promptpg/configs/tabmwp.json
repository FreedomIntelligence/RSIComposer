{
  "objective": "Train the PromptPG example selector and compare three conditions on held-out TabMWP",
  "data_dir": "../../../../../runs/promptpg-tabmwp",
  "max_decision_steps": 400,
  "backends": {
    "local": {"kind": "chat_completions", "endpoint": "http://127.0.0.1:18096/v1", "json_mode": false}
