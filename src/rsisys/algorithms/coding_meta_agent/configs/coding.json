              "http://127.0.0.1:18506/v1",
              "http://127.0.0.1:18507/v1"
            ],
            "model": "Qwen3.5-9B",
            "workers": 14,
            "max_candidates": 5,
            "min_candidates": 3,
            "max_steps": 48,
            "max_tokens": 4096,
            "total_tokens": 98304,
