{
  "objective": "TTRL native official verl: full-parameter MATH-500, 64 votes / 32 train, 10 epochs, 16-sample pass@1",
  "data_dir": "../../../../../runs/ttrl-paper",
  "max_decision_steps": 16,
  "framework": {
    "method": {
      "name": "ttrl_verl",
      "config": {
        "controller": {
          "initial_model": "models/Qwen2.5-7B-d1497293",
          "train_data": "runs/ttrl-paper-data/unlabeled.json",
          "eval_data": "runs/ttrl-paper-data/evaluation.json",
          "iterations": 1,
          "samples_per_prompt": 64
        },
        "labs": {
          "ttrl": {
            "upstream_root": "/absolute/path/to/ttrl",
            "seed": 73,
            "enforce_eager": true,
            "native_overrides": {
              "actor_rollout_ref.rollout.gpu_memory_utilization": 0.65,
              "data.dataloader_num_workers": 0
            },
            "training_python": "/absolute/path/to/ttrl-env/bin/python",
            "inference_python": "/absolute/path/to/ttrl-env/bin/python",
            "save_freq": 2000000
          }
        }
      }
    }
  },
  "resources": {
    "executor": "local",
    "pools": {
      "train": {
        "nodes": 1,
        "gpus": [
          0,
          1,
          2,
          3,
          4,
          5,
          6,
          7
        ],
        "gpus_per_node": 8
      }
    },
    "placement": {
      "ttrl.rollout": {
        "pool": "train",
        "gpus": 8
      },
      "ttrl.trainer": {
        "pool": "train",
        "gpus": 8
      }
    }
  }
}
