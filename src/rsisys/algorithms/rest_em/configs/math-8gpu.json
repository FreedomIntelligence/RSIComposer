{
  "objective": "Eight-GPU ReST^EM with Qwen2.5-7B Base on MATH",
  "data_dir": "../../../../../runs/rest-em-math-8gpu",
  "max_decision_steps": 12,
  "framework": {
    "method": {
      "name": "rest_em",
      "config": {
        "controller": {
          "initial_model": "models/Qwen2.5-7B-d1497293",
          "train_data": "train",
