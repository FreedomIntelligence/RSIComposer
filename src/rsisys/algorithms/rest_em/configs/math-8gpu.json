          "iterations": 2,
          "samples_per_prompt": 8,
          "max_accepted_per_prompt": 4
        },
        "labs": {
          "math": {
            "engine": "vllm",
            "model_kind": "causal_lm",
            "prompt_format": "completion",
            "answer_format": "latex",
            "few_shot_data": "runs/math-data/few-shot.jsonl",
            "device": "cuda",
            "epochs": 1,
            "learning_rate": 2e-05,
            "max_new_tokens": 2048,
            "max_length": 8192,
            "seed": 73,
            "train_batch_size": 1,
            "gradient_accumulation_steps": 1,
            "gpu_memory_utilization": 0.85,
            "max_num_seqs": 128,
            "max_num_batched_tokens": 16384,
            "train_gradient_checkpointing": false,
            "manifest": "runs/math-data/manifest.json"
          }
        }
      }
    }
  },
  "resources": {
    "executor": "local",
    "pools": {
      "train": {
