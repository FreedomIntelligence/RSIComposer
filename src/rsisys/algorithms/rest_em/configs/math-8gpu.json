        "gpus": [
          0,
          1,
          2,
          3,
          4,
          5,
          6,
          7
        ],
        "gpus_per_node": 8
      }
    },
    "placement": {
      "math.rollout": {
        "pool": "train",
        "gpus": 8,
        "timeout": 3600
      },
      "math.trainer": {
        "pool": "train",
        "gpus": 8,
        "timeout": 3600
      }
    }
  }
