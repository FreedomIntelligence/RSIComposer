{
  "objective": "Native GEPA with two prompt components on a small GSM8K cohort",
  "data_dir": "../../../../../runs/gepa-merge-screen",
  "max_decision_steps": 80,
  "backends": {
    "local": {
      "kind": "chat_completions",
      "endpoint": "http://127.0.0.1:18096/v1",
      "timeout_seconds": 180
    }
  },
  "roles": {
    "decision_maker": {"backend_id": "local", "model_id": "Qwen3.5-9B", "revision": "local-readonly-base"},
    "actor": {"backend_id": "local", "model_id": "Qwen3.5-9B", "revision": "local-readonly-base"}
  },
  "framework": {
    "method": {
      "name": "gepa_merge",
      "config": {
        "controller": {
          "source_dir": "external/gepa",
          "seed": 17,
          "data": {"search_count": 24, "validation_count": 12, "test_count": 32},
          "parameters": {
            "initial_components": {
              "strategy": "Translate the problem into equations and solve them step by step.",
              "verification": "Check the result against the quantities and units in the question."
            },
            "rounds": 8,
            "minibatch_size": 4,
            "use_merge": true,
            "max_merge_invocations": 5,
            "max_metric_calls": 96,
            "max_reflection_calls": 28,
            "optimizer_max_output_tokens": 2048
          },
          "model": {"optimizer_temperature": 1.0}
        },
        "labs": {
          "gepa": {
            "seed": 17,
            "data": {"search_count": 24, "validation_count": 12, "test_count": 32},
            "files": {
              "search": "data/gepa-merge-screen/search.jsonl",
              "validation": "data/gepa-merge-screen/validation.jsonl",
              "test": "data/gepa-merge-screen/test.jsonl"
            },
            "max_model_calls": 160,
            "model": {"max_output_tokens": 2048, "scorer_temperature": 0.0}
          }
        }
      }
    }
  }
}
