{
  "objective": "Improve the fixed-model math inference harness through search feedback. Inspect baseline, measure it, propose general harness changes and measure candidates. Choose whether to continue and which candidate to finalize using search evidence and token cost. Finalize once to compare selected vs baseline on heldout, then finish with an honest report. No weight updates or validated self-reflection are installed.",
  "data_dir": "../../../../../runs/meta-agent-math",
  "max_decision_steps": 32,
  "backends": {
    "local": {
      "kind": "chat_completions",
      "endpoint": "http://127.0.0.1:18480/v1",
      "timeout_seconds": 600,
      "json_mode": true
    }
  },
  "roles": {
    "decision_maker": {
      "backend_id": "local",
      "model_id": "rsisys-research",
      "revision": "frozen-local-deployment"
    }
  },
  "framework": {
    "method": {
      "name": "meta_agent",
      "config": {
        "controller": {
          "memory": true,
          "harness": "default",
          "backend": "vllm",
          "max_output_tokens": 4096,
          "max_model_calls": 128,
          "context_window": 24576
        },
        "labs": {
          "math": {
            "model": "rsisys-fixed",
            "endpoints": [
              "http://127.0.0.1:18400/v1",
              "http://127.0.0.1:18401/v1",
              "http://127.0.0.1:18402/v1",
              "http://127.0.0.1:18403/v1"
            ],
            "search_data": "runs/rrsi-data/search.jsonl",
            "heldout_data": "runs/rrsi-data/heldout.jsonl",
            "verifier": "math_verify",
            "max_calls": 3,
            "max_tokens": 2048,
            "workers": 512,
            "grading_workers": 16,
            "sandbox_workers": 32,
            "seed": 73,
            "temperature": 0.7,
            "initial_harness": "src/rsisys/algorithms/meta_agent/seed_harness.py",
            "max_candidates": 6,
            "trials": 2,
            "final_trials": 2,
            "output_subdir": "meta-agent-math"
          }
        }
      }
    }
  }
}
